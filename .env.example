# testnet or mainnet
NEAR_NETWORK=testnet

# Keel factory that creates founders' vaults
FACTORY_ACCOUNT_ID=keel.testnet

# Keel's agent key file from `node scripts/new-agent-key.mjs`. Keep it outside
# this repository. The agent signs as each vault with this key, which the factory
# adds to every vault, limited to execute_payment and propose_payment.
AGENT_KEY_FILE=~/.near-credentials/keel-agent-key.json

# USDC token contract on the chosen network
USDC_CONTRACT_ID=

# Optional 1Click partner token (https://partners.near-intents.org); removes the 0.2% fee
ONECLICK_JWT=
