# testnet or mainnet
NEAR_NETWORK=testnet

# Account that holds the full-access key. Its private key never goes in this file.
OWNER_ACCOUNT_ID=

# Agent's function-call key, scoped to the vault's execute_payment and propose_payment
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=

# Deployed Keel Vault
VAULT_ACCOUNT_ID=

# USDC token contract on the chosen network
USDC_CONTRACT_ID=

# Optional 1Click partner token (https://partners.near-intents.org); removes the 0.2% fee
ONECLICK_JWT=
