{
  "name": "keel-demo-video",
  "private": true,
  "type": "module",
  "description": "Keel's demo video, made in code: Playwright captures the app, Remotion animates, numpy/scipy synthesize the sound, FFmpeg exports.",
  "scripts": {
    "capture": "node capture.mjs",
    "sound": "python3 sound.py",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts KeelDemo out/keel-raw.mp4 --concurrency=4",
    "export": "node export.mjs",
    "video": "npm run sound && npm run render && npm run export"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "@remotion/google-fonts": "4.0.538",
    "@remotion/transitions": "4.0.538",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
